# ============================================================
#  CricketNepal Backend - Environment Variables
#  Copy this file to .env and fill in your values
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=5000

# --- MongoDB ---
# Get from: https://cloud.mongodb.com (MongoDB Atlas Free Tier)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cricketnepal?retryWrites=true&w=majority

# --- JWT ---
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_min_32_chars
JWT_EXPIRE=30d
JWT_COOKIE_EXPIRE=30

# --- Cloudinary (Free Image Hosting) ---
# Get from: https://cloudinary.com (free tier)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Email (Nodemailer via Gmail) ---
# Enable "App Passwords" in your Google Account for SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_app_password_here
FROM_EMAIL=noreply@cricketnepal.com
FROM_NAME=CricketNepal

# --- Frontend URL (for CORS and email links) ---
FRONTEND_URL=http://localhost:5173

# --- Khalti Payment Gateway (Nepal) ---
# Test keys from: https://khalti.com/api/docs/
KHALTI_SECRET_KEY=test_secret_key_xxxxxxxxxxxxxxxxxxxxxxxx
KHALTI_PUBLIC_KEY=test_public_key_xxxxxxxxxxxxxxxxxxxxxxxx
KHALTI_BASE_URL=https://a.khalti.com/api/v2

# --- eSewa Payment Gateway (Nepal) ---
# Test credentials from: https://developer.esewa.com.np/
ESEWA_MERCHANT_ID=EPAYTEST
# eSewa HMAC secret key (test value below — get live key from eSewa merchant portal)
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q
ESEWA_BASE_URL=https://rc-epay.esewa.com.np
ESEWA_SUCCESS_URL=http://localhost:5173/payment/success
ESEWA_FAILURE_URL=http://localhost:5173/payment/failure
